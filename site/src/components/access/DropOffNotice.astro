---
import Tape from "../ui/Tape.astro";
import access from "../../data/access.json";

/*
 * 学校前の住宅地での乗降車禁止。
 *
 * 送迎だけの人は駐車場の案内を読み飛ばしがちなので、駐車場セクションの中ではなく
 * ページ冒頭に置いている。見た目はカード（黒枠＋ハードシャドウ）に赤テープと赤見出しで、
 * 警告ストライプや赤枠まで足すと威圧的すぎたので控えた。
 */
const notice = access.notice;
---

<section class="dropoff" aria-labelledby="dropoff-title" data-dropoff-notice>
  <Tape color="red" rotate={-3} as="p" class="label">
    {notice.label}
  </Tape>

  <h2 id="dropoff-title" class="title">{notice.title}</h2>

  <p class="lead">{notice.lead}</p>

  {notice.text.map((text) => (
    <p>{text}</p>
  ))}
</section>

<style>
  .dropoff {
    position: relative;
    margin-bottom: 48px;
    padding: 30px 18px 20px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    font-size: 14px;
    line-height: 1.8;
  }

  .dropoff :global(.label) {
    position: absolute;
    top: -16px;
    left: 12px;
    font-size: 15px;
    letter-spacing: 0.08em;
  }

  .title {
    margin-bottom: 12px;
    color: var(--red);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.45;
  }

  .lead {
    font-size: 15px;
    font-weight: 800;
  }

  .dropoff p + p {
    margin-top: 10px;
  }

  @media (min-width: 900px) {
    .dropoff {
      margin-bottom: 56px;
      padding: 34px 28px 24px;
      font-size: 15px;
    }

    .title {
      font-size: 24px;
    }

    .lead {
      font-size: 16px;
    }
  }
</style>
