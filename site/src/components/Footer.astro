---
import site from "../data/site.json";
import sponsors from "../data/sponsors.json";
import Tape from "./ui/Tape.astro";

import { Image } from "astro:assets";


const imageFiles = import.meta.glob(
  "../assets/sponsors/*.{png,jpg,jpeg,webp}",
  {
    eager: true,
    import: "default",
  }
);

function getImage(filename?: string | null) {
  if (!filename) return null;
  const path = `../assets/sponsors/${filename}`;

  return imageFiles[path] ?? null;
}
---

<footer class="site-footer">
  <div class="inner">
    <Tape color="yellow" rotate={-1.5} as="p" class="footer-title">{site.eventNameEn}</Tape>

    <div class="sponsors-line">
      
      <h4>主要協賛</h4>

      <div class="sponsor-group">
        <span class="label">法人協賛</span>
        <ul class="grid">
        {
        sponsors
          .filter((s) => s.type === "corporate" && s.featured)
          .sort((a, b) => a.name.localeCompare(b.name, "ja"))
          .map((s) => {
            const image = getImage(s.logo);
            return (
              <li class="slot">
                {image ? (
                  <Image src={image} alt={s.name} />
                ) : (
                  s.name
                )}
              </li>
            );
          })
        }
        </ul>
      </div>

      <div class="sponsor-group">
        <span class="label">個人協賛</span>
        <ul class="grid">
        {
        sponsors
          .filter((s) => s.type === "individual" && s.featured)
          .sort((a, b) => a.name.localeCompare(b.name, "ja"))
          .map((s) => {
            const image = getImage(s.logo);

            return (
              <li class="slot">
                {image ? (
                  <Image src={image} alt={s.name} />
                ) : (
                  s.name
                )}
              </li>
            );
          })
        }
        </ul>
      </div>
    </div>
  
    <div class="contact">
      {site.sns.instagram && (
        <a href={site.sns.instagram} class="sns" aria-label="Instagram">
          Instagram
        </a>
      )}
      {site.sns.x && (
        <a href={site.sns.x} class="sns" aria-label="X">
          X
        </a>
      )}
      {site.phone && <span class="phone num">{site.phone}</span>}
      <a href={`mailto:${site.contactEmail}`} class="email">{site.contactEmail}</a>
    </div>

    <p class="copyright">{site.eventName}「{site.theme}」実行委員会</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #fff;
    text-align: center;
    /* 下端はホームインジケータに潜らせない */
    padding: 40px 20px calc(32px + env(safe-area-inset-bottom, 0px));
    margin-top: 40px;
  }

  .inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* Tapeにpropsで渡したclassは子コンポーネント側のスコープになるため :global() が要る */
  .site-footer :global(.footer-title) {
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .sponsors-line {
    width: 100%;
  }

  .sponsors-line .label {
    margin-top:10px;
    display: block;
    font-size: 11px;
    letter-spacing: 0.15em;
    opacity: 0.7;
    margin-bottom: 10px;
  }

  .sponsors-line ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 18px;
    font-size: 12.5px;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px;
    font-size: 12.5px;
  }

  .sns,
  .email {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .copyright {
    font-size: 11px;
    opacity: 0.6;
  }

.slot {
  background: var(--paper);
  border: 2px solid #ffffff;
  padding: 0;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;
  font-weight: 700;
  color: var(--ink);
  width: 150px;
  height: 120px;
  font-size: 16px;
}

.slot img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

  @media (min-width: 900px) {
    .slot {
  width: 200px;
  height:160px;
   font-size: 20px;
}
  }

</style>
