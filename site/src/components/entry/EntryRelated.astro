---
// 記事内に並べる、別の企画へのリンクカード（entry.related）。
// わらしべ長者・バザーグランプリの紹介枠のように、記事の中身が「別の企画の案内」になっている
// ときに使う。見た目は timetable の常設セクションのカード（左に写真、右に名前と要約）に揃える。
// カードの中に別のリンク（CTA）を持たないので、カードごと <a> で包む。
import { optimizeEntryPhoto } from "../../lib/entryPhotos";
import type { Entry } from "../../types/content";

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const cards = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    photo: entry.image ? await optimizeEntryPhoto(entry.image) : null,
  })),
);
---

{
  cards.length > 0 && (
    <ul class="related">
      {cards.map(({ entry, photo }) => (
        <li>
          <a class="related-card" href={`/entry/${entry.id}/`}>
            {/* 写真が無い企画は写真枠ごと出さない（boothのカード・常設セクションと同じ方針） */}
            {photo && (
              <span class="related-photo">
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="110px"
                  width={photo.width}
                  height={photo.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </span>
            )}
            <span class="related-body">
              <span class="related-name">{entry.name}</span>
              {entry.summary && <span class="related-summary">{entry.summary}</span>}
              <span class="related-more num" aria-hidden="true">
                view more →
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .related {
    list-style: none;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .related-card {
    display: flex;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .related-card:active {
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .related-card:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  .related-photo {
    display: flex;
    flex: 0 0 110px;
    background: #f3ebd9;
    border-right: 2px solid var(--ink);
  }

  .related-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-body {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .related-name {
    font-size: 15px;
    font-weight: 800;
  }

  .related-summary {
    font-size: 12.5px;
    line-height: 1.6;
    color: #444;
  }

  .related-more {
    align-self: flex-start;
    margin-top: 4px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--blue);
    border-bottom: 2px solid var(--blue);
    line-height: 1.1;
  }

  @media (hover: hover) {
    .related-card:hover {
      transform: translate(-1px, -1px);
      box-shadow: 6px 6px 0 var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card {
      transition: none;
    }
  }
</style>
