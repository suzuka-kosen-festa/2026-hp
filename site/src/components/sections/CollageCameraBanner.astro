---
import Reveal from "../motion/Reveal";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import Tape from "../ui/Tape.astro";
import { getFeaturedEntries } from "../../lib/entries";
import { entries } from "../../lib/loadEntries";

const [entry] = getFeaturedEntries(entries);
---

{
  entry && (
    <section class="collage-camera">
      <Reveal client:visible rotate={-1}>
        <Card rotate={-1} attach="tape" cornerColor="blue" class="banner">
          <div class="photo">
            {entry.image ? (
              <img src={entry.image} alt="" loading="lazy" />
            ) : (
              <span class="no-image num">NO IMAGE</span>
            )}
          </div>
          <div class="body">
            <Tape color="blue" rotate={-1.5} as="p" class="label">
              常設企画
            </Tape>
            <h2 class="name">{entry.name}</h2>
            {entry.description && <p class="description">{entry.description}</p>}
            {entry.link && (
              <Button href={entry.link} color="yellow" rotate={-1} class="cta">
                やってみる
              </Button>
            )}
          </div>
        </Card>
      </Reveal>
    </section>
  )
}

<style>
  .collage-camera {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 20px 32px;
  }

  /* Cardコンポーネントにpropsとして渡すclassのため、レンダリングされるdivは
     Card.astro自身のスコープになる。ここではグローバルセレクタで指定する */
  :global(.collage-camera .banner) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 18px 18px;
  }

  .photo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: #f3ebd9;
    border: 2px solid var(--ink);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-image {
    font-size: 13px;
    letter-spacing: 0.05em;
    color: #999;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  :global(.collage-camera .label) {
    font-size: 11px;
  }

  .name {
    font-size: 20px;
  }

  .description {
    font-size: 13.5px;
    line-height: 1.7;
  }

  :global(.collage-camera .cta) {
    margin-top: 4px;
  }

  @media (min-width: 900px) {
    .collage-camera {
      max-width: 1200px;
    }

    :global(.collage-camera .banner) {
      flex-direction: row;
      align-items: stretch;
      gap: 32px;
      padding: 28px 32px;
    }

    .photo {
      flex: 0 0 340px;
      aspect-ratio: 16 / 10;
    }

    .body {
      justify-content: center;
    }

    .name {
      font-size: 28px;
    }

    .description {
      font-size: 15px;
      max-width: 46ch;
    }
  }
</style>
