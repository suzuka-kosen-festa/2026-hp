---
// home の PICK UP 枠。banner を持つ常設企画（ミッションフォトラリー等）のバナーを全件そのまま並べる。
// 以前は featured の PromoList がここだったが、載っていた事前応募制の企画が締切済みになり撤去した。
// 見た目とリンクの組み方は booth / timetable と同じ EntryBanner を使う。
// バナーは操作する部品ではないので client: は付けず、静的なHTMLとして出す
import Reveal from "../motion/Reveal";
import Tape from "../ui/Tape.astro";
import EntryBanner from "../EntryBanner";
import { entries } from "../../lib/loadEntries";
import { withEntryPhotos } from "../../lib/entryPhotos";

// 画像の最適化は banner を持つ企画だけにかける（全件に掛けるとビルドが遅くなる）
const banners = (await withEntryPhotos(entries.filter((entry) => entry.banner))).filter(
  (entry) => entry.bannerPhoto,
);
---

{
  banners.length > 0 && (
    <section class="entry-banners" id="pickup">
      <Reveal client:visible rotate={-1.2}>
        <Tape color="red" rotate={-1.2} as="h2" class="sec-title">
          PICK UP
        </Tape>
      </Reveal>
      <div class="banner-list">
        {banners.map((entry) => (
          <EntryBanner entry={entry} />
        ))}
      </div>
    </section>
  )
}

<style>
  /* 上下は他のセクション（NewsPreview 等）と同じ 32px。
     紙片の回転とハードシャドウ（5px）がはみ出すぶんもこの余白で受ける */
  .entry-banners {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 32px 20px;
  }

  /* 見出しがヘッダーに隠れないよう逃がす（SponsorsSection の #individual と同じ考え方）。
     Reveal の登場前（y: 24px 下）の位置でスクロールするので、そのぶんも見込む */
  #pickup {
    scroll-margin-top: calc(var(--header-offset-sp) + 24px);
  }

  /* Tapeにpropsで渡したclassは子コンポーネント側のスコープになるため :global() が要る */
  .entry-banners :global(.sec-title) {
    margin-bottom: 22px;
    font-size: 17px;
  }

  .banner-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .entry-banners {
      max-width: var(--content-narrow);
    }
    /* PCは2枚を横に並べる（縦に並べると高さが500pxを超える）。1枚だけなら中央 */
    .banner-list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 28px;
    }
    .banner-list > :global(.entry-banner) {
      flex: 0 1 calc((100% - 28px) / 2);
      max-width: 480px;
      margin-inline: 0;
      min-width: 0;
    }
  }
</style>
