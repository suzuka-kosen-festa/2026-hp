---
import Reveal from "../motion/Reveal";
import Tape from "../ui/Tape.astro";
import Button from "../ui/Button.astro";

/* リンク先はテーマ記事（news.json の theme-collage）。
   記事のidを変えるとここが404になるので、home.spec.ts で存在を検査している */
const themeArticle = "/news/theme-collage/";
---

<section class="about">
  <Reveal client:visible>
    <Tape color="yellow" rotate={-1.5} as="h2" class="sec-title">ABOUT</Tape>
    <p class="lead">
      今年のテーマは「collage(コラージュ)」。<br />
      個性も、アイデアも、技術も、想いも、<br />
      全部重なってひとつの"最高"を作る。
    </p>
    {/* すぐ上のNEWSセクションと同じ語彙（Button）で揃える。
        Aboutは一覧ではなく1つの文章なので、全体をリンクにすると
        リンク名が段落まるごとになり読み上げが破綻する */}
    <Button href={themeArticle} class="read-more">collageについて →</Button>
  </Reveal>
</section>

<style>
  .about {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 32px 20px;
  }

  /* Tapeにpropsで渡したclassは子コンポーネント側のスコープになるため :global() が要る */
  .about :global(.sec-title) {
    margin-bottom: 20px;
    font-size: 17px;
  }

  .lead {
    font-size: 15px;
    line-height: 2;
    font-weight: 700;
  }

  .about :global(.read-more) {
    margin-top: 20px;
  }

  @media (min-width: 900px) {
    .about {
      max-width: var(--content-narrow);
      text-align: center;
    }
    .lead {
      font-size: 18px;
    }
  }
</style>
