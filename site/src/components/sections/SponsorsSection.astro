---
import Reveal from "../motion/Reveal";
import Tape from "../ui/Tape.astro";
import Star from "../ui/Star.astro";
import { Image } from "astro:assets";
import sponsors from "../../data/sponsors.json";

/* 協賛ロゴはフッターと同じ置き場から拾う */
const logoFiles = import.meta.glob("../../assets/sponsors/*.{png,jpg,jpeg,webp}", {
  eager: true,
  import: "default",
});

function getLogo(filename?: string | null) {
  if (!filename) return null;
  return logoFiles[`../../assets/sponsors/${filename}`] ?? null;
}

/**
 * 並び順は「主要協賛(featured) → ロゴあり → 五十音」。
 * featured はフッターに載るのと同じ企業で、ロゴを持っていることが多い。
 * ロゴありを先に出すのは、名前だけのスロットが上に並ぶと見栄えが落ちるため。
 */
function ordered(type: string) {
  return sponsors
    .filter((s) => s.type === type)
    .sort((a, b) => {
      if (!!a.featured !== !!b.featured) return a.featured ? -1 : 1;
      const aLogo = !!getLogo(a.logo);
      const bLogo = !!getLogo(b.logo);
      if (aLogo !== bLogo) return aLogo ? -1 : 1;
      return a.name.localeCompare(b.name, "ja");
    });
}
---

<section class="sponsors">
  <!-- Figma書き出しのテクスチャ画像ではなく、コードファーストのSVGパターンで
       左右それぞれ違う組み合わせのコラージュ角飾りを表現する -->
  <div class="deco-layer" aria-hidden="true">
    <div class="deco-stack bl">
      <svg class="swatch s1" width="88" height="64"><rect width="88" height="64" fill="url(#check-blue)" filter="url(#torn-edge)"></rect></svg>
      <svg class="swatch s2" width="64" height="90"><rect width="64" height="90" fill="url(#stripe-red)" filter="url(#torn-edge)"></rect></svg>
      <Star class="star" color="var(--yellow)" size="26px" rotate={-10} />
    </div>
    <div class="deco-stack br">
      <svg class="swatch s1" width="70" height="98"><rect width="70" height="98" fill="url(#dots-black)" filter="url(#torn-edge)"></rect></svg>
      <svg class="swatch s2" width="80" height="56"><rect width="80" height="56" fill="url(#stripe-black)" filter="url(#torn-edge)"></rect></svg>
      <Star class="star" color="var(--red)" size="22px" rotate={16} />
    </div>
  </div>

  <Reveal client:visible>
  <Tape color="black" rotate={-1.2} as="h2" class="sec-title">SPONSORS</Tape>

  <div class="sponsor-group">
    <h3>法人協賛</h3>
    <ul class="grid">
      {
        ordered("corporate").map((s) => {
          const logo = getLogo(s.logo);
          const body = logo ? <Image src={logo} alt={s.name} /> : <span>{s.name}</span>;
          return (
            <li class:list={["slot", { "is-featured": s.featured }]}>
              {/* リンクを持たない協賛もあるので、url があるときだけリンクにする */}
              {s.url ? (
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {body}
                </a>
              ) : (
                body
              )}
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="sponsor-group">
    <h3>個人協賛</h3>
    <ul class="grid">
      {
        ordered("individual").map((s) => (
          <li class="slot">
            {s.url ? (
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                <span>{s.name}</span>
              </a>
            ) : (
              <span>{s.name}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Reveal>
</section>

<style>
  .sponsors {
    position: relative;
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 32px 20px 60px;
    overflow: hidden;
  }

  .deco-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .deco-stack {
    position: absolute;
    bottom: 6%;
  }
  .deco-stack.bl {
    left: -6px;
  }
  .deco-stack.br {
    right: -6px;
  }

  .deco-stack .swatch {
    position: absolute;
    filter: drop-shadow(3px 3px 0 var(--ink));
  }
  .deco-stack.bl .s1 {
    left: 0;
    bottom: 30px;
    transform: rotate(-6deg);
  }
  .deco-stack.bl .s2 {
    left: 46px;
    bottom: 0;
    transform: rotate(5deg);
  }
  .deco-stack.br .s1 {
    right: 0;
    bottom: 20px;
    transform: rotate(6deg);
  }
  .deco-stack.br .s2 {
    right: 50px;
    bottom: -10px;
    transform: rotate(-5deg);
  }

  .deco-stack :global(.star) {
    position: absolute;
  }
  .deco-stack.bl :global(.star) {
    left: 18px;
    bottom: 96px;
  }
  .deco-stack.br :global(.star) {
    right: 24px;
    bottom: 88px;
  }

  /* Tape/Starにpropsで渡したclassは子コンポーネント側のスコープになるため :global() が要る */
  .sponsors :global(.sec-title) {
    position: relative;
    z-index: 1;
    margin-bottom: 22px;
    font-size: 17px;
  }

  .grid {
    position: relative;
    z-index: 1;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .slot {
    background: #fff;
    border: 2px solid var(--ink);
    padding: 18px 10px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    /* ロゴありと名前のみが混在するので、高さを揃えて中央に置く */
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 76px;
  }

  /* 主要協賛はロゴを載せるぶん少し大きく取る */
  .slot.is-featured {
    min-height: 104px;
    padding: 12px;
  }

  /* リンクの有無で見た目が変わらないよう、スロット全体を当たり判定にする */
  .slot a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: inherit;
  }

  .slot img {
    max-width: 100%;
    max-height: 80px;
    object-fit: contain;
  }

  .sponsor-group {
    position: relative;
    z-index: 1;
    margin-bottom: 32px;
  }


  @media (min-width: 900px) {
    .sponsors {
      max-width: var(--content-wide);
      padding: 40px 24px 100px;
    }
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }


</style>
