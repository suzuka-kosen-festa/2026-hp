---
import Reveal from "../motion/Reveal";
import Tape from "../ui/Tape.astro";
import NewsItem from "../ui/NewsItem.astro";
import Button from "../ui/Button.astro";
import { getNews, getNewsHref, isNew } from "../../lib/news";

const latest = getNews(3);
---

<section class="news-preview">
  <Reveal client:visible>
    <Tape color="blue" rotate={-1.5} as="h2" class="sec-title">NEWS</Tape>
    <div class="list">
      {latest.map((n) => <NewsItem date={n.date} href={getNewsHref(n)} isNew={isNew(n.date)}>{n.title}</NewsItem>)}
    </div>
    <Button href="/news/" class="view-all">view all →</Button>
  </Reveal>
</section>

<style>
  .news-preview {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 32px 20px;
  }

  /* Tape/Buttonにpropsで渡したclassは子コンポーネント側のスコープになるため :global() が要る */
  .news-preview :global(.sec-title) {
    margin-bottom: 20px;
    font-size: 17px;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .news-preview :global(.view-all) {
    margin-top: 22px;
  }

  @media (min-width: 900px) {
    .news-preview {
      max-width: var(--content-narrow);
    }
  }
</style>
