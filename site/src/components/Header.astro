---
import HamburgerMenu from "./motion/HamburgerMenu";

const navItems = [
  { label: "HOME", href: "/" },
  { label: "TIMETABLE", href: "/timetable/" },
  { label: "MAP", href: "/map/" },
  { label: "BOOTH", href: "/booth/" },
  { label: "ACCESS", href: "/access/" },
  { label: "SPONSORS", href: "/sponsors/" },
  { label: "NEWS", href: "/news/" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<!-- スクロール量の判定用。IntersectionObserverでこれが画面外に出たらヘッダーを縮める。
     scrollイベントを毎フレーム拾うより安く、レイアウトにも影響しない -->
<div class="header-sentinel" aria-hidden="true"></div>

<header class="site-header">
  <!-- ===== PC ===== -->
  <div class="header-pc">
    <a href="/" class="logo">
      <span>SUZUKA</span>
      <span>KOSEN</span>
      <span>FESTIVAL</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {
          navItems.map((item, i) => (
            <li>
              {i > 0 && <span class="tick" aria-hidden="true" />}
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- ===== SP ===== -->
  <div class="header-sp">
    <a href="/" class="logo-sp">SUZUKA KOSEN FESTIVAL</a>
    <HamburgerMenu client:idle navItems={navItems} currentPath={currentPath} />
  </div>
</header>

<style>
  /* iOS Safari はスクロールに合わせてツールバーを伸縮させるが、その遷移中は
     position:fixed の要素の再配置が遅れる。結果、ツールバーが空けた帯にページ本体が
     見えたままヘッダーだけが下に取り残される（Issue #42）。sticky は通常フローに
     参加するのでこの遅れが起きない */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* iOS Safari はツールバーを畳む遷移の途中で、可視領域(ビジュアルビューポート)の
     上端がレイアウトビューポートより上に出る（実機計測で visualViewport.offsetTop が
     -46 まで振れた）。sticky の基準はレイアウトビューポートなのでヘッダーはそこに
     届かず、帯にページ本文が覗く（Issue #42）。ヘッダーの地を上方向へ伸ばして塞ぐ。
     見た目に何も描いていないように見えるが、消すと再発するので削除しないこと。
     スクロール0のときは画面外に出るだけなので影響しない */
  .site-header::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 240px;
    background: var(--paper);
    pointer-events: none;
  }

  .header-sentinel {
    position: absolute;
    top: 0;
    width: 1px;
    /* この高さぶんスクロールしたら縮む */
    height: 100px;
    pointer-events: none;
  }

  /* ===== PC ===== */
  .header-pc {
    display: none;
  }

  @media (min-width: 900px) {
    .header-pc {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      max-width: 1325px;
      margin: 0 auto;
      padding: 18px 24px 0;
    }

    /* sticky で本文の上に乗るので、下のコンテンツが透けないよう地を敷く */
    .site-header {
      background: var(--paper);
    }

    /* ===== 縮小状態（Issue #43） =====
       ロゴを3行組みから1行に畳んで 106px → 56px。高さは --header-height-pc と
       対応させること（TabTagFilter等がこの変数を top に使っている） */
    :global(html.is-header-shrunk) .header-pc {
      align-items: center;
      height: var(--header-height-pc);
      padding-top: 0;
      padding-bottom: 0;
    }

    :global(html.is-header-shrunk) .logo {
      flex-direction: row;
      gap: 0.3em;
      font-size: 20px;
      line-height: 1;
    }

    :global(html.is-header-shrunk) nav a {
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .header-pc,
    .logo,
    nav a {
      transition:
        height 0.18s ease,
        padding 0.18s ease,
        font-size 0.18s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .header-pc,
      .logo,
      nav a {
        transition: none;
      }
    }
  }

  .logo {
    display: flex;
    flex-direction: column;
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.05;
    color: var(--ink);
  }

  nav ul {
    display: flex;
    list-style: none;
    align-items: center;
  }

  nav li {
    display: flex;
    align-items: center;
  }

  nav a {
    display: block;
    position: relative;
    padding: 12px 14px;
    font-family: var(--font-num);
    font-size: 19px;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6px;
    height: 6px;
    background: var(--red);
    filter: url(#tape-edge);
    opacity: 0;
    transform: scaleX(0.8);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transition: none;
    }
  }

  .tick {
    width: 1px;
    height: 14px;
    background: #ccc;
  }

  /* ===== SP ===== */
  /* 位置決めは親の .site-header (sticky) が持つ。ここは中身の並びだけ */
  .header-sp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    /* 安全領域ぶんも自分の背景で塞ぐ。ここを空けるとステータスバーの裏に
       本文が透けて見える（Issue #42） */
    height: var(--header-offset-sp);
    padding-top: var(--safe-top);
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-bottom: 0;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    box-sizing: border-box;
  }

  .logo-sp {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.1;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* PC切り替え時にSPバーを隠す。.header-spの基本定義より後ろに置くことで
     ソース順で確実に上書きする */
  @media (min-width: 900px) {
    .header-sp {
      display: none;
    }
  }
</style>

<script>
  // sentinel が画面外に出た＝100px以上スクロールした、とみなしてヘッダーを縮める。
  // クラスは html に付ける。--header-height-pc を :root で切り替えるため
  // （TabTagFilter の sticky top もこの変数を見ている）
  const sentinel = document.querySelector(".header-sentinel");
  if (sentinel) {
    new IntersectionObserver(
      ([entry]) => {
        document.documentElement.classList.toggle("is-header-shrunk", !entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>
