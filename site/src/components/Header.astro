---
import HamburgerMenu from "./motion/HamburgerMenu";

const navItems = [
  { label: "HOME", href: "/" },
  { label: "TIMETABLE", href: "/timetable/" },
  { label: "MAP", href: "/map/" },
  { label: "BOOTH", href: "/booth/" },
  { label: "ACCESS", href: "/access/" },
  { label: "SPONSORS", href: "/sponsors/" },
  { label: "NEWS", href: "/news/" },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <!-- ===== PC ===== -->
  <div class="header-pc">
    <a href="/" class="logo">
      <span>SUZUKA</span>
      <span>KOSEN</span>
      <span>FESTIVAL</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {
          navItems.map((item, i) => (
            <li>
              {i > 0 && <span class="tick" aria-hidden="true" />}
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- ===== SP ===== -->
  <div class="header-sp">
    <a href="/" class="logo-sp">SUZUKA KOSEN FESTIVAL</a>
    <HamburgerMenu client:idle navItems={navItems} currentPath={currentPath} />
  </div>
</header>

<style>
  /* iOS Safari はスクロールに合わせてツールバーを伸縮させるが、その遷移中は
     position:fixed の要素の再配置が遅れる。結果、ツールバーが空けた帯にページ本体が
     見えたままヘッダーだけが下に取り残される（Issue #42）。sticky は通常フローに
     参加するのでこの遅れが起きない */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* iOS Safari はツールバーを畳む遷移の途中で、可視領域(ビジュアルビューポート)の
     上端がレイアウトビューポートより上に出る（実機計測で visualViewport.offsetTop が
     -46 まで振れた）。sticky の基準はレイアウトビューポートなのでヘッダーはそこに
     届かず、帯にページ本文が覗く（Issue #42）。ヘッダーの地を上方向へ伸ばして塞ぐ。
     見た目に何も描いていないように見えるが、消すと再発するので削除しないこと。
     スクロール0のときは画面外に出るだけなので影響しない */
  .site-header::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 240px;
    background: var(--paper);
    pointer-events: none;
  }

  /* ===== PC ===== */
  .header-pc {
    display: none;
  }

  @media (min-width: 900px) {
    .header-pc {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      max-width: 1325px;
      margin: 0 auto;
      /* height を明示しないと auto になり、縮小時の height 遷移が補間されず
         「文字だけ滑らかに縮んで箱は一瞬で飛ぶ」状態になる */
      height: var(--header-height-pc);
      padding: 18px 24px 0;
    }

    /* sticky で本文の上に乗るので、下のコンテンツが透けないよう地を敷く */
    .site-header {
      background: var(--paper);
    }

    /* ===== 縮小状態（Issue #43） =====
       ロゴを3行組みから1行に畳んで 106px → 56px。高さは --header-height-pc-shrunk と
       必ず一致させること（TabTagFilter等がこの変数を sticky の top に使っている） */
    :global(html.is-header-shrunk) .header-pc {
      align-items: center;
      height: var(--header-height-pc-shrunk);
      padding-top: 0;
      padding-bottom: 0;
    }

    :global(html.is-header-shrunk) .logo {
      flex-direction: row;
      gap: 0.3em;
      font-size: 20px;
      line-height: 1;
    }

    :global(html.is-header-shrunk) nav a {
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .header-pc,
    .logo,
    nav a {
      transition:
        height 0.18s ease,
        padding 0.18s ease,
        font-size 0.18s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .header-pc,
      .logo,
      nav a {
        transition: none;
      }
    }
  }

  .logo {
    display: flex;
    flex-direction: column;
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.05;
    color: var(--ink);
  }

  nav ul {
    display: flex;
    list-style: none;
    align-items: center;
  }

  nav li {
    display: flex;
    align-items: center;
  }

  nav a {
    display: block;
    position: relative;
    padding: 12px 14px;
    font-family: var(--font-num);
    font-size: 19px;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6px;
    height: 6px;
    background: var(--red);
    filter: url(#tape-edge);
    opacity: 0;
    transform: scaleX(0.8);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }

  nav a:hover::after,
  nav a[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    nav a::after {
      transition: none;
    }
  }

  .tick {
    width: 1px;
    height: 14px;
    background: #ccc;
  }

  /* ===== SP ===== */
  /* 位置決めは親の .site-header (sticky) が持つ。ここは中身の並びだけ */
  .header-sp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    /* 安全領域ぶんも自分の背景で塞ぐ。ここを空けるとステータスバーの裏に
       本文が透けて見える（Issue #42） */
    height: var(--header-offset-sp);
    padding-top: var(--safe-top);
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    padding-bottom: 0;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    box-sizing: border-box;
  }

  .logo-sp {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-logo);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.1;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* PC切り替え時にSPバーを隠す。.header-spの基本定義より後ろに置くことで
     ソース順で確実に上書きする */
  @media (min-width: 900px) {
    .header-sp {
      display: none;
    }
  }
</style>

<script>
  // スクロール量でヘッダーの縮小を切り替える。
  // クラスは html に付ける（PC限定のスタイルはCSS側の media query で絞る）。
  // 縮む/戻るの閾値をずらす（ヒステリシス）。
  // ヘッダーが縮むとページ全体が50px詰まり、ブラウザのスクロールアンカリングが
  // 見えている位置を保とうと scrollY を戻す。閾値が1点だとその戻りで判定が反転し、
  // 「縮む→戻される→展開→…」を高速に往復してガクガクする（実測で確認）。
  // 差(100px)をレイアウトのズレ(50px)より大きく取れば往復しない
  const SHRINK_AT = 140;
  const EXPAND_AT = 40;

  let shrunk = false;
  let ticking = false;

  function updateHeaderState() {
    const y = window.scrollY;
    if (!shrunk && y > SHRINK_AT) {
      shrunk = true;
      document.documentElement.classList.add("is-header-shrunk");
    } else if (shrunk && y < EXPAND_AT) {
      shrunk = false;
      document.documentElement.classList.remove("is-header-shrunk");
    }
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      updateHeaderState();
    });
  }

  updateHeaderState();
  addEventListener("scroll", onScroll, { passive: true });
</script>
