---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import NewsPreview from "../components/sections/NewsPreview.astro";
import About from "../components/sections/About.astro";
import ContentsCards from "../components/sections/ContentsCards.astro";
import FeaturedPromos from "../components/sections/FeaturedPromos.astro";
import Divider from "../components/ui/Divider.astro";
import OpSplash from "../components/motion/OpSplash";

// 検索結果に出る説明文。BaseLayout の既定（サイト名だけ）だとGoogleが本文から勝手に抜き出し、
// PICK UP の企画紹介が出てしまっていたので、開催日・場所とテーマ（ABOUTの文言）を明示する
const description =
  "第61回鈴鹿高専祭「collage（コラージュ）」は2026年10月31日（土）・11月1日（日）、鈴鹿工業高等専門学校で開催。個性も、アイデアも、技術も、想いも、全部重なってひとつの“最高”を作る。";
---

<BaseLayout title="collage 2026 | 第61回鈴鹿高専祭" description={description}>
  <div id="op-cover" aria-hidden="true"></div>
  <script is:inline>
    // 再訪問者はOpSplash(Reactアイランド)を待たずに即カバーを外す。
    // 初回訪問者はOpSplashのマウント時に自分でこのカバーを外す
    (function () {
      try {
        if (sessionStorage.getItem("op-seen")) {
          document.getElementById("op-cover")?.remove();
        }
      } catch (e) {
        /* noop */
      }
    })();
  </script>
  <OpSplash client:load />
  <Hero />
  <Divider color="red" />
  <NewsPreview />
  <Divider color="blue" />
  <About />
  <Divider color="red" />
  <ContentsCards />
  <FeaturedPromos />
</BaseLayout>
