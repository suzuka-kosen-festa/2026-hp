---
// 開発用コンポーネントギャラリー。design-demo/demo.html の後継。
// 本番サイトの導線には含めない（サイトマップ・ナビからリンクしない）。
import BaseLayout from "../layouts/BaseLayout.astro";
import Tape from "../components/ui/Tape.astro";
import Chip from "../components/ui/Chip.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import NewsItem from "../components/ui/NewsItem.astro";
import Divider from "../components/ui/Divider.astro";
import Star from "../components/ui/Star.astro";
import Reveal from "../components/motion/Reveal";
import PromoStack from "../components/motion/PromoStack";
import PromoList from "../components/motion/PromoList";
import PromoCarousel from "../components/motion/PromoCarousel";
import { getFeaturedEntries } from "../lib/entries";
import { entries } from "../lib/loadEntries";

const featured = getFeaturedEntries(entries);
/** PromoStack.tsx の LAYERS[1].x と揃えること（覗いている端の幅＝edge方式の実質タップ幅） */
const PEEK_PX = 16;
---

<BaseLayout title="部品ギャラリー（開発用）" noindex>
  <section class="gallery">
    <h1 class="page-title">部品ギャラリー</h1>
    <p class="note">実装済みコンポーネントの一覧です。デザイン確認・調整用（本番導線には含まれません）。</p>

    <div class="part">
      <h2>Tape</h2>
      <div class="row">
        <Tape color="black">black</Tape>
        <Tape color="red" rotate={2}>red</Tape>
        <Tape color="blue" rotate={-2}>blue</Tape>
        <Tape color="yellow" rotate={1.5}>yellow</Tape>
      </div>
    </div>

    <div class="part">
      <h2>Chip</h2>
      <div class="row">
        <Chip color="red">飲食</Chip>
        <Chip color="blue">物販</Chip>
      </div>
    </div>

    <div class="part">
      <h2>Button</h2>
      <div class="row">
        <Button href="#">view all →</Button>
        <Button href="#" color="yellow">場内マップを見る</Button>
      </div>
    </div>

    <div class="part">
      <h2>Star</h2>
      <div class="row">
        <Star color="var(--red)" size="40px" rotate={12} />
        <Star color="var(--yellow)" size="28px" rotate={-15} />
        <Star color="var(--blue)" size="34px" />
      </div>
    </div>

    <div class="part">
      <h2>Divider</h2>
      <Divider color="red" />
      <Divider color="blue" />
    </div>

    <div class="part">
      <h2>NewsItem</h2>
      <div style="max-width:420px">
        <NewsItem date="2026.09.15" isNew href="#">ステージ企画の出演者を発表しました</NewsItem>
        <NewsItem date="2026.09.01" href="#">模擬店の出店一覧を公開しました</NewsItem>
      </div>
    </div>

    <div class="part">
      <h2>Card — attach: tape / pin / none</h2>
      <div class="row">
        <Card rotate={-1}>
          <p style="font-weight:800;">やきそば屋台</p>
          <p style="font-size:13px;margin-top:6px;">3年電気電子工学科。鉄板で焼き上げるソース焼きそば。</p>
        </Card>
        <Card rotate={1} cornerColor="blue">
          <p style="font-weight:800;">カフェ企画</p>
          <p style="font-size:13px;margin-top:6px;">1年一般教養。焼き菓子とドリンクの販売。</p>
        </Card>
        <Card rotate={-1.2} attach="pin">
          <p style="font-weight:800;">画鋲どめver</p>
          <p style="font-size:13px;margin-top:6px;">掲示板に留めたような見た目。</p>
        </Card>
        <Card rotate={1.2} attach="pin" cornerColor="blue">
          <p style="font-weight:800;">画鋲どめver（青）</p>
          <p style="font-size:13px;margin-top:6px;">色違いも用意。</p>
        </Card>
        <Card rotate={0.6} attach="none">
          <p style="font-weight:800;">留め具なしver</p>
          <p style="font-size:13px;margin-top:6px;">カードだけを並べたい場合に。</p>
        </Card>
      </div>
    </div>

    <div class="part">
      <h2>Card — texture: 紙っぽい質感ver</h2>
      <p class="note">背景(body)の繊維ノイズとは粒度を変えたクラフト紙風のムラ。テープ/画鋲とも組み合わせ可能。</p>
      <div class="row">
        <Card rotate={-1} texture>
          <p style="font-weight:800;">紙質感 + テープ</p>
          <p style="font-size:13px;margin-top:6px;">クラフト紙っぽい色味とムラ。</p>
        </Card>
        <Card rotate={1} texture attach="pin" cornerColor="red">
          <p style="font-weight:800;">紙質感 + 画鋲</p>
          <p style="font-size:13px;margin-top:6px;">組み合わせ例。</p>
        </Card>
      </div>
    </div>

    <div class="part">
      <h2>Reveal（Framer Motion, スクロールで発火）</h2>
      <Reveal client:visible>
        <Card rotate={-0.8}>
          <p style="font-weight:800;">スクロールで登場</p>
        </Card>
      </Reveal>
    </div>

    <div class="part">
      <h2>複数広告の切り替え方式の比較（A/B/C/D）</h2>
      <p class="sub">
        広告（featured企画）が2件以上になったときの見せ方の候補。カードの見た目は4案とも共通で、<strong>操作方法だけ</strong>が違います。
        <strong>「タップ領域を表示」を押すと押せる範囲が赤破線で出る</strong>ので、指で押せるかを実機で確かめてください。
        参考値: WCAG 2.5.8(AA)の最小は24×24px、Apple HIGの推奨は44×44px。
      </p>

      <label class="hit-toggle">
        <input type="checkbox" id="hit-toggle" />
        タップ領域を表示
      </label>

      <h3>A: 覗いている端を直接タップ</h3>
      <p class="sub">
        背面カードそのものがボタン。ただし前面カードに覆われているので、実際に押せるのは右側に覗いた
        <strong>約{PEEK_PX}px幅の帯だけ</strong>になる。
        トレードオフ: 見た目が一番シンプルで1手で切り替わるが、<strong>24pxにも届かず指では狙えない</strong>。
      </p>
      <div class="promo-slot" data-promo>
        <PromoStack client:visible entries={featured} control="edge" />
      </div>

      <h3>B: スタックは見せるだけ、選択はテープタブ</h3>
      <p class="sub">
        重なりは「まだ他にもある」を伝える役だけを担い、切り替えは下のタブで行う。タブは最小44px確保。
        トレードオフ: 1手で切り替わり企画名も読めるが、<strong>件数が増えるとタブが折り返して縦に伸びる</strong>。
      </p>
      <div class="promo-slot" data-promo>
        <PromoStack client:visible entries={featured} control="tabs" />
      </div>

      <h3>C: 全件を常時表示（採用）</h3>
      <p class="sub">
        広告は多くても4件程度と分かったため、そもそも畳まない。Wallet型の弱点だった
        <strong>「2手かかる」「展開すると畳んだ状態より情報が減る」が両方消える</strong>。
        行全体が詳細ページへのリンクなので、タップ領域は行の全面。カード内にCTAリンクを置かないため
        リンクの入れ子にもならない。<strong>home専用ではなくエントリ配列を受け取るだけなので、他ページの広告枠にも流用できる</strong>。
      </p>
      <div class="promo-slot" data-promo>
        <PromoList client:visible entries={featured} />
      </div>

      <h3>D: カルーセル（横スワイプ＋ドット）</h3>
      <p class="sub">
        横スクロールはCSSの scroll-snap に任せているので、指の慣性・キーボード・スクロールバーがネイティブのまま効く。
        両隣が覗いているので「まだある」ことは見た目で分かる。矢印とドットはどちらも44×44px。
        トレードオフ: <strong>1手で次に行ける</strong>反面、コラージュの「重ね貼り」感は薄く、横スクロール領域が縦スクロールと競合しやすい。
      </p>
      <div class="promo-slot promo-slot--wide" data-promo>
        <PromoCarousel client:visible entries={featured} />
      </div>

      <h3>参考: 広告が1件のとき</h3>
      <p class="sub">重なりも切り替えUIも出さず、現行バナーと同じ1枚として表示される。</p>
      <div class="promo-slot" data-promo>
        <PromoStack client:visible entries={featured.slice(0, 1)} control="tabs" />
      </div>
    </div>
  </section>

  <script>
    // タップ領域の可視化トグル（A/B/C/D すべての候補に一括適用）
    const HIT_TARGETS: [string, string][] = [
      [".ps", "ps--hit"],
      [".pl", "pl--hit"],
      [".pcar", "pcar--hit"],
    ];
    document.getElementById("hit-toggle")?.addEventListener("change", (e) => {
      const on = (e.target as HTMLInputElement).checked;
      for (const [selector, modifier] of HIT_TARGETS) {
        document.querySelectorAll(selector).forEach((el) => el.classList.toggle(modifier, on));
      }
    });
  </script>

  <style>
    .gallery {
      max-width: 700px;
      margin: 0 auto;
      padding: 32px 20px 80px;
    }
    .page-title {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 8px;
    }
    .sub {
      font-size: 13px;
      line-height: 1.7;
      color: #555;
      margin-bottom: 12px;
    }
    h3 {
      font-size: 14px;
      margin: 28px 0 6px;
    }
    .hit-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      font-size: 13px;
      font-weight: 700;
    }
    /* 背面カードが右にはみ出すので、比較用スロットは余白を確保して切らずに見せる */
    .promo-slot {
      padding: 8px 40px 8px 8px;
    }
    /* カルーセルは自前で左右に覗き代を持つので、右の余白は要らない */
    .promo-slot--wide {
      padding: 8px 0;
    }
    .note {
      font-size: 13px;
      color: #666;
      margin-bottom: 32px;
    }
    .part {
      margin-bottom: 40px;
    }
    .part h2 {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #666;
      margin-bottom: 14px;
      text-transform: uppercase;
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }
  </style>
</BaseLayout>
