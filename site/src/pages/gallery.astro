---
// 開発用コンポーネントギャラリー。design-demo/demo.html の後継。
// 本番サイトの導線には含めない（サイトマップ・ナビからリンクしない）。
import BaseLayout from "../layouts/BaseLayout.astro";
import Tape from "../components/ui/Tape.astro";
import Chip from "../components/ui/Chip.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import NewsItem from "../components/ui/NewsItem.astro";
import Divider from "../components/ui/Divider.astro";
import Star from "../components/ui/Star.astro";
import Reveal from "../components/motion/Reveal";
import PromoList from "../components/motion/PromoList";
import { getFeaturedEntries } from "../lib/entries";
import { entries } from "../lib/loadEntries";

const featured = getFeaturedEntries(entries);
---

<BaseLayout title="部品ギャラリー（開発用）" noindex>
  <section class="gallery">
    <h1 class="page-title">部品ギャラリー</h1>
    <p class="note">実装済みコンポーネントの一覧です。デザイン確認・調整用（本番導線には含まれません）。</p>

    <!-- 端末依存の不具合（Issue #42 等）を実機で切り分けるための計測値。
         開発用ページなので本番導線には出ない -->
    <div class="part">
      <h2>端末情報（デバッグ用）</h2>
      <p class="note">スマホ固有の不具合を追うとき、この値をDiscordに貼ってください。</p>
      <div class="safe-probe" aria-hidden="true"></div>
      <dl class="device-info"><dt>読み込み中…</dt><dd></dd></dl>
    </div>

    <div class="part">
      <h2>Tape</h2>
      <div class="row">
        <Tape color="black">black</Tape>
        <Tape color="red" rotate={2}>red</Tape>
        <Tape color="blue" rotate={-2}>blue</Tape>
        <Tape color="yellow" rotate={1.5}>yellow</Tape>
      </div>
    </div>

    <div class="part">
      <h2>Chip</h2>
      <div class="row">
        <Chip color="red">飲食</Chip>
        <Chip color="blue">物販</Chip>
      </div>
    </div>

    <div class="part">
      <h2>Button</h2>
      <div class="row">
        <Button href="#">view all →</Button>
        <Button href="#" color="yellow">場内マップを見る</Button>
      </div>
    </div>

    <div class="part">
      <h2>Star</h2>
      <div class="row">
        <Star color="var(--red)" size="40px" rotate={12} />
        <Star color="var(--yellow)" size="28px" rotate={-15} />
        <Star color="var(--blue)" size="34px" />
      </div>
    </div>

    <div class="part">
      <h2>Divider</h2>
      <Divider color="red" />
      <Divider color="blue" />
    </div>

    <div class="part">
      <h2>NewsItem</h2>
      <div style="max-width:420px">
        <NewsItem date="2026.09.15" isNew href="#">ステージ企画の出演者を発表しました</NewsItem>
        <NewsItem date="2026.09.01" href="#">模擬店の出店一覧を公開しました</NewsItem>
      </div>
    </div>

    <div class="part">
      <h2>Card — attach: tape / pin / none</h2>
      <div class="row">
        <Card rotate={-1}>
          <p style="font-weight:800;">やきそば屋台</p>
          <p style="font-size:13px;margin-top:6px;">3年電気電子工学科。鉄板で焼き上げるソース焼きそば。</p>
        </Card>
        <Card rotate={1} cornerColor="blue">
          <p style="font-weight:800;">カフェ企画</p>
          <p style="font-size:13px;margin-top:6px;">1年一般教養。焼き菓子とドリンクの販売。</p>
        </Card>
        <Card rotate={-1.2} attach="pin">
          <p style="font-weight:800;">画鋲どめver</p>
          <p style="font-size:13px;margin-top:6px;">掲示板に留めたような見た目。</p>
        </Card>
        <Card rotate={1.2} attach="pin" cornerColor="blue">
          <p style="font-weight:800;">画鋲どめver（青）</p>
          <p style="font-size:13px;margin-top:6px;">色違いも用意。</p>
        </Card>
        <Card rotate={0.6} attach="none">
          <p style="font-weight:800;">留め具なしver</p>
          <p style="font-size:13px;margin-top:6px;">カードだけを並べたい場合に。</p>
        </Card>
      </div>
    </div>

    <div class="part">
      <h2>Card — texture: 紙っぽい質感ver</h2>
      <p class="note">背景(body)の繊維ノイズとは粒度を変えたクラフト紙風のムラ。テープ/画鋲とも組み合わせ可能。</p>
      <div class="row">
        <Card rotate={-1} texture>
          <p style="font-weight:800;">紙質感 + テープ</p>
          <p style="font-size:13px;margin-top:6px;">クラフト紙っぽい色味とムラ。</p>
        </Card>
        <Card rotate={1} texture attach="pin" cornerColor="red">
          <p style="font-weight:800;">紙質感 + 画鋲</p>
          <p style="font-size:13px;margin-top:6px;">組み合わせ例。</p>
        </Card>
      </div>
    </div>

    <div class="part">
      <h2>Reveal（Framer Motion, スクロールで発火）</h2>
      <Reveal client:visible>
        <Card rotate={-0.8}>
          <p style="font-weight:800;">スクロールで登場</p>
        </Card>
      </Reveal>
    </div>

    <div class="part">
      <h2>広告一覧（PromoList）</h2>
      <p class="sub">
        featured企画の一覧。home の PICK UP 枠で使用。行全体が詳細ページへのリンクで、タップ領域は行の全面。
        <strong>home専用ではなくエントリ配列を受け取るだけなので、他ページの広告枠にも流用できる</strong>。
        <strong>「タップ領域を表示」を押すと押せる範囲が赤破線で出ます</strong>。
        参考値: WCAG 2.5.8(AA)の最小は24×24px、Apple HIGの推奨は44×44px。
      </p>
      <p class="sub">
        切り替えUI（重ねてタブで選ぶ・カルーセル）も検討したが、広告は多くても4件程度のため畳まないのが最善と判断した。
        経緯は requirements.md §3.9 を参照。
      </p>

      <label class="hit-toggle">
        <input type="checkbox" id="hit-toggle" />
        タップ領域を表示
      </label>

      <div class="promo-slot" data-promo>
        <PromoList client:visible entries={featured} />
      </div>

      <h3>参考: 広告が1件のとき</h3>
      <div class="promo-slot" data-promo>
        <PromoList client:visible entries={featured.slice(0, 1)} />
      </div>
    </div>
  </section>

  <script>
    // タップ領域の可視化トグル
    document.getElementById("hit-toggle")?.addEventListener("change", (e) => {
      const on = (e.target as HTMLInputElement).checked;
      document.querySelectorAll(".pl").forEach((el) => el.classList.toggle("pl--hit", on));
    });
  </script>

  <style>
    .gallery {
      max-width: 700px;
      margin: 0 auto;
      padding: 32px 20px 80px;
    }
    .page-title {
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 8px;
    }
    .sub {
      font-size: 13px;
      line-height: 1.7;
      color: #555;
      margin-bottom: 12px;
    }
    h3 {
      font-size: 14px;
      margin: 28px 0 6px;
    }
    .hit-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      font-size: 13px;
      font-weight: 700;
    }
    /* 回転したカードのハードシャドウが切れないよう余白を確保する */
    .promo-slot {
      padding: 8px;
    }
    .note {
      font-size: 13px;
      color: #666;
      margin-bottom: 32px;
    }
    .part {
      margin-bottom: 40px;
    }
    .part h2 {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: #666;
      margin-bottom: 14px;
      text-transform: uppercase;
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
    }
  
  /* 端末情報（デバッグ用） */
  .safe-probe {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    padding-top: env(safe-area-inset-top, 0px);
    padding-right: env(safe-area-inset-right, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    pointer-events: none;
    visibility: hidden;
  }

  .device-info {
    font-family: var(--font-day);
    font-size: 12px;
    line-height: 1.7;
    background: #fff;
    border: 2px solid var(--ink);
    padding: 12px 14px;
    overflow-wrap: anywhere;
  }

  .device-info dt {
    font-weight: 700;
    color: var(--blue);
  }

  .device-info dd {
    margin: 0 0 6px;
  }
</style>
</BaseLayout>
<script>
  // 安全領域は JS から直接読めないので、env() を padding に流した非表示要素を測る
  const probe = document.querySelector(".safe-probe");
  const dl = document.querySelector(".device-info");
  if (probe && dl) {
    const cs = getComputedStyle(probe);
    const root = getComputedStyle(document.documentElement);
    const vv = window.visualViewport;
    const rows = {
      "safe-area-inset (上/右/下/左)": [cs.paddingTop, cs.paddingRight, cs.paddingBottom, cs.paddingLeft].join(" / "),
      "--safe-top": root.getPropertyValue("--safe-top").trim() || "(未定義)",
      "--header-offset-sp": root.getPropertyValue("--header-offset-sp").trim() || "(未定義)",
      "window.inner (W×H)": `${window.innerWidth} × ${window.innerHeight}`,
      "documentElement.client (W×H)": `${document.documentElement.clientWidth} × ${document.documentElement.clientHeight}`,
      "visualViewport (W×H)": vv ? `${Math.round(vv.width)} × ${Math.round(vv.height)}` : "(なし)",
      "visualViewport offsetTop / pageTop": vv ? `${vv.offsetTop} / ${vv.pageTop}` : "(なし)",
      "devicePixelRatio": String(window.devicePixelRatio),
      "ヘッダー実測 top / height": (() => {
        const h = document.querySelector(".site-header");
        if (!h) return "(なし)";
        const r = h.getBoundingClientRect();
        return `${r.top.toFixed(1)} / ${r.height.toFixed(1)}`;
      })(),
      "userAgent": navigator.userAgent,
    };
    dl.innerHTML = Object.entries(rows)
      .map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`)
      .join("");
  }
</script>

