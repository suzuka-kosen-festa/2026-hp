---
// 企画の汎用詳細ページ。バナーやカードの「view more」の飛び先。
// 当初は「個別詳細ページなし」の方針だったが、I科ワークショップのように
// 開催回・対象・定員・注記まで持つ企画が出てきて、バナーやカードの
// 限られた面積では情報を出しきれなくなったため追加した（requirements.md §3.3）。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tape from "../../components/ui/Tape.astro";
import Chip from "../../components/ui/Chip.astro";
import Button from "../../components/ui/Button.astro";
import Star from "../../components/ui/Star.astro";
import EntryFacts from "../../components/entry/EntryFacts.astro";
import EntryNotes from "../../components/entry/EntryNotes.astro";
import EntryApply from "../../components/entry/EntryApply.astro";
import EntryResources from "../../components/entry/EntryResources.astro";
import EntryPartSection from "../../components/entry/EntryPartSection.astro";
import EntryRelated from "../../components/entry/EntryRelated.astro";
import EntryNeighbors from "../../components/entry/EntryNeighbors.astro";
import { entries } from "../../lib/loadEntries";
import { getStageNeighbors } from "../../lib/entries";
import { optimizeEntryPhoto } from "../../lib/entryPhotos";
import { dayColorClass, formatDayLabel } from "../../lib/eventDate";
import { displayTags as toDisplayTags, tagColor, tagLabel } from "../../lib/tags";
import type { Entry } from "../../types/content";
import site from "../../data/site.json";

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

// 表示用のタグからは日付タグを落とす（開催日は下の「開催」欄で正確に出しているため重複する）。
// 落とす判定と表示名・色は lib/tags.ts が唯一の持ち主（Issue #53）
const displayTags = toDisplayTags(entry.tags);

const photo = entry.image ? await optimizeEntryPhoto(entry.image) : null;

// 同じステージ・同じタブの並びでの前後の企画（timetable に載る企画だけ。出番ごとに1段）
const neighbors = getStageNeighbors(entries, entry);

// 記事内でリンクカードにする別の企画。id の書き間違いは本番で黙ってカードが消えるので、ビルドを止める
const related = (entry.related ?? []).map((id) => {
  const found = entries.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`[entry] ${entry.id} の related に書かれた "${id}" という企画がありません`);
  return found;
});

// 代表者を先頭に並べる（ラベルは付けない）。データでは代表者とその他を分けて持っている
const members = [...(entry.leader ? [entry.leader] : []), ...(entry.members ?? [])];

// 複数の企画を載せる記事（ゲーム大会等）。開催・定員・申込は企画ごとの欄に出すので、
// 記事全体の欄には場所・対象などの共通部分だけを出す
const parts = entry.parts ?? [];
const hasParts = parts.length > 0;
/** 紙片を貼り重ねたように見せるため、企画ごとに見出しの傾きを散らす */
const PART_TILTS = [-1.2, 1, -0.8, 1.2];
---

<BaseLayout title={`${entry.name} | ${site.eventName}`} description={entry.summary ?? entry.description ?? entry.comment ?? undefined}>
  <article class="entry">
    {/* 「企画一覧へ」の決め打ちだと、/booth/ が準備中のあいだは準備中ページに
        着地する。実際にトップのPICK UPから入った人が戻れなくなっていた
        （MTG 2026-09-06）。素直に元いたページへ帰す。
        履歴が無いとき（検索やQRからの直接着地）はトップへ。行き先が毎回変わるので
        ラベルは「戻る」にしてある */}
    <p class="crumb"><a href="/" data-back>← 戻る</a></p>

    <header class="head">
      <Tape color="blue" rotate={-1.5} as="p" class="cat">{entry.categoryLabel ?? entry.category}</Tape>
      <h1 class="name">{entry.name}</h1>
      {entry.reading && <p class="reading">{entry.reading}</p>}
      {entry.group && <p class="group">{entry.group}</p>}
      {
        displayTags.length > 0 && (
          <ul class="tags">
            {displayTags.map((tag) => (
              <li>
                <Chip color={tagColor(tag)}>{tagLabel(tag)}</Chip>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      /* 写真を用意できない企画は今後も存在するので、画像なしを正式なレイアウトとして扱う。
         「NO IMAGE」の空枠を出すと、16:9ぶんの高さがそのまま無駄になる（Issue #56） */
      photo && (
        <div class="photo">
          {/* 本文幅（SPは画面幅−40px、PCは最大700px）。寸法を付けて、読み込み中に本文がずれないようにする */}
          <img
            src={photo.src}
            srcset={photo.srcset}
            sizes="(min-width: 900px) 700px, calc(100vw - 40px)"
            width={photo.width}
            height={photo.height}
            alt=""
            loading="eager"
            fetchpriority="high"
          />
          <Star class="photo-star" color="var(--yellow)" size="30px" rotate={-12} />
        </div>
      )
    }

    {
      /* 出演者本人の言葉なので、企画説明（description）とは見た目を分けて引用として出す */
      entry.comment && (
        <figure class="comment">
          <Tape color="yellow" rotate={-2} as="figcaption" class="comment-label">ひとこと</Tape>
          <blockquote>{entry.comment}</blockquote>
        </figure>
      )
    }

    {entry.description && <p class="desc">{entry.description}</p>}

    <EntryRelated entries={related} />

    {
      /* 企画ごとの欄へのページ内リンク。スマホでは記事が縦に長くなるので、
         自分が出たい企画まで一気に飛べるようにする */
      hasParts && (
        <nav class="parts-nav" aria-label="この記事の企画">
          <ul>
            {parts.map((part) => (
              <li>
                <a href={`#${part.id}`}>
                  {part.occurrences[0] && (
                    <span class:list={["num", "parts-nav-day", dayColorClass(part.occurrences[0].day)]}>
                      {formatDayLabel(part.occurrences[0].day)}
                    </span>
                  )}
                  <span class="parts-nav-name">{part.name}</span>
                  <span class="parts-nav-arrow" aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <EntryFacts
      period={entry.period}
      participation={entry.participation}
      members={members}
      occurrences={hasParts ? [] : entry.occurrences}
      isPermanent={entry.isPermanent}
      location={entry.location}
      audience={entry.audience}
      capacity={entry.capacity}
      fee={entry.fee}
      application={entry.application}
      extraFacts={entry.extraFacts}
    />

    <EntryNotes notes={entry.notes} />

    {entry.application && <EntryApply application={entry.application} occurrences={entry.occurrences} />}

    <EntryResources resources={entry.resources} />

    {parts.map((part, i) => <EntryPartSection part={part} rotate={PART_TILTS[i % PART_TILTS.length]} />)}

    {
      entry.link && (
        <div class="cta">
          <Button href={entry.link} color="yellow" rotate={-1}>
            {entry.linkLabel ?? "やってみる →"}
          </Button>
        </div>
      )
    }

    <EntryNeighbors neighbors={neighbors} />
  </article>
<script>
  import { statusAt } from "../../lib/application";

  /* JSが動かなくても href="/" の普通のリンクとして機能する。
     サイト内から来たときだけ履歴を1つ戻す */
  document.querySelector<HTMLAnchorElement>("a[data-back]")?.addEventListener("click", (event) => {
    const sameOrigin = document.referrer.startsWith(`${location.origin}/`);
    if (!sameOrigin || history.length <= 1) return;

    event.preventDefault();
    history.back();
  });

  /* 申込ボタンの出し分けを閲覧時の時刻で合わせ直す。
     複数の企画を載せる記事では企画ごとに締切が違うので、1つずつ判定する */
  document.querySelectorAll<HTMLElement>("[data-apply]").forEach((apply) => {
    const status = statusAt(Number(apply.dataset.opensAt), Number(apply.dataset.closesAt), Date.now());
    apply.querySelectorAll<HTMLElement>("[data-apply-state]").forEach((el) => {
      el.hidden = el.dataset.applyState !== status;
    });
  });
</script>
</BaseLayout>

<style>
  .entry {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .crumb {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .crumb a {
    text-decoration: underline;
  }

  /* Tape/Chip/Star にpropsで渡したclassは子コンポーネント側のスコープになるため
     :global() が要る（design-system.md §4 参照） */
  .head :global(.cat) {
    font-size: 11px;
    margin-bottom: 12px;
  }

  .name {
    font-size: clamp(22px, 6.5vw, 30px);
    line-height: 1.35;
  }

  .reading {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
    color: #555;
  }

  .group {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 14px;
  }

  /* 枠は写真の縦横比に合わせる。16:9に固定して切り抜くと、バンドのロゴ画像（正方形）や
     縦長の集合写真で文字やメンバーが切れる */
  .photo {
    position: relative;
    margin-top: 22px;
    background: #f3ebd9;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    rotate: -0.8deg;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .photo :global(.photo-star) {
    position: absolute;
    top: -14px;
    right: -10px;
  }

  .comment {
    position: relative;
    margin-top: 30px;
    padding: 20px 18px 16px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .comment :global(.comment-label) {
    position: absolute;
    top: -14px;
    left: 12px;
    padding: 4px 14px;
    font-size: 11px;
  }
  .comment blockquote {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.8;
    /* 出演者が入れた改行をそのまま活かす */
    white-space: pre-line;
  }

  .desc {
    margin-top: 26px;
    font-size: 14.5px;
    line-height: 1.9;
    /* データ側の改行をそのまま活かす */
    white-space: pre-line;
  }

  .cta {
    margin-top: 28px;
  }

  /* 企画へのページ内リンク。貼った付箋のように1行ずつ並べる */
  .parts-nav ul {
    list-style: none;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .parts-nav a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    padding: 10px 14px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 14px;
    font-weight: 700;
  }

  .parts-nav-day {
    font-size: 15px;
  }

  .parts-nav-day.sat {
    color: var(--blue);
  }

  .parts-nav-day.sun {
    color: var(--red);
  }

  .parts-nav-name {
    flex: 1;
    min-width: 0;
  }

  .parts-nav-arrow {
    color: var(--blue);
  }

  @media (min-width: 900px) {
    .entry {
      /* --content-narrow はPR #27で追加。未マージのあいだはフォールバックで動く */
      max-width: var(--content-narrow, 700px);
      padding: 40px 24px 96px;
    }
    .desc {
      font-size: 16px;
    }
    .fact {
      font-size: 15px;
    }
  }
</style>
