---
// 企画の汎用詳細ページ。バナーやカードの「view more」の飛び先。
// 当初は「個別詳細ページなし」の方針だったが、I科ワークショップのように
// 開催回・対象・定員・注記まで持つ企画が出てきて、バナーやカードの
// 限られた面積では情報を出しきれなくなったため追加した（requirements.md §3.3）。
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tape from "../../components/ui/Tape.astro";
import Chip from "../../components/ui/Chip.astro";
import Button from "../../components/ui/Button.astro";
import Star from "../../components/ui/Star.astro";
import { entries } from "../../lib/loadEntries";
import { dayColorClass, formatDayLabel } from "../../lib/eventDate";
import { displayTags as toDisplayTags, tagColor, tagLabel } from "../../lib/tags";
import { applicationStatus, applicationWindow, formatApplicationDate } from "../../lib/application";
import type { Day, Entry, Occurrence } from "../../types/content";
import site from "../../data/site.json";

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;

/** 開催回を日ごとにまとめる。同じ日に複数公演ある企画（化学マジック等）を1行に畳むため */
function groupByDay(occurrences: Occurrence[]) {
  const order: Day[] = ["day1", "day2"];
  return order
    .map((day) => ({ day, items: occurrences.filter((o) => o.day === day) }))
    .filter((group) => group.items.length > 0);
}

function formatTime(occurrence: Occurrence) {
  if (!occurrence.start_time) return "時間未定";
  return occurrence.end_time ? `${occurrence.start_time}-${occurrence.end_time}` : `${occurrence.start_time}〜`;
}

const dayGroups = groupByDay(entry.occurrences);
const hasSchedule = entry.isPermanent || dayGroups.length > 0;
// 表示用のタグからは日付タグを落とす（開催日は上の「開催」欄で正確に出しているため重複する）。
// 落とす判定と表示名・色は lib/tags.ts が唯一の持ち主（Issue #53）
const displayTags = toDisplayTags(entry.tags);

// 代表者を先頭に並べる（ラベルは付けない）。データでは代表者とその他を分けて持っている
const members = [...(entry.leader ? [entry.leader] : []), ...(entry.members ?? [])];

const application = entry.application ?? null;
const applicationTimes = application ? applicationWindow(application) : null;
const applicationStatusAtBuild = application ? applicationStatus(application, Date.now()) : null;
---

<BaseLayout title={`${entry.name} | ${site.eventName}`} description={entry.summary ?? entry.description ?? entry.comment ?? undefined}>
  <article class="entry">
    {/* 「企画一覧へ」の決め打ちだと、/booth/ が準備中のあいだは準備中ページに
        着地する。実際にトップのPICK UPから入った人が戻れなくなっていた
        （MTG 2026-09-06）。素直に元いたページへ帰す。
        履歴が無いとき（検索やQRからの直接着地）はトップへ。行き先が毎回変わるので
        ラベルは「戻る」にしてある */}
    <p class="crumb"><a href="/" data-back>← 戻る</a></p>

    <header class="head">
      <Tape color="blue" rotate={-1.5} as="p" class="cat">{entry.categoryLabel ?? entry.category}</Tape>
      <h1 class="name">{entry.name}</h1>
      {entry.reading && <p class="reading">{entry.reading}</p>}
      {entry.group && <p class="group">{entry.group}</p>}
      {
        displayTags.length > 0 && (
          <ul class="tags">
            {displayTags.map((tag) => (
              <li>
                <Chip color={tagColor(tag)}>{tagLabel(tag)}</Chip>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      /* 写真を用意できない企画は今後も存在するので、画像なしを正式なレイアウトとして扱う。
         「NO IMAGE」の空枠を出すと、16:9ぶんの高さがそのまま無駄になる（Issue #56） */
      entry.image && (
        <div class="photo">
          <img src={entry.image} alt="" loading="eager" fetchpriority="high" />
          <Star class="photo-star" color="var(--yellow)" size="30px" rotate={-12} />
        </div>
      )
    }

    {
      /* 出演者本人の言葉なので、企画説明（description）とは見た目を分けて引用として出す */
      entry.comment && (
        <figure class="comment">
          <Tape color="yellow" rotate={-2} as="figcaption" class="comment-label">ひとこと</Tape>
          <blockquote>{entry.comment}</blockquote>
        </figure>
      )
    }

    {entry.description && <p class="desc">{entry.description}</p>}

    <dl class="facts">
      {
        hasSchedule && (
          <div class="fact">
            <dt>開催</dt>
            <dd>
              {entry.isPermanent ? (
                <span>会期中ずっと</span>
              ) : (
                <ul class="days">
                  {dayGroups.map((group) => (
                    <li>
                      <span class:list={["day", "num", dayColorClass(group.day)]}>{formatDayLabel(group.day)}</span>
                      <span class="times">
                        {group.items.map((o) => (
                          <span class="slot">
                            <span class="num">{formatTime(o)}</span>
                            {o.note && <span class="slot-note">（{o.note}）</span>}
                          </span>
                        ))}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </dd>
          </div>
        )
      }
      {
        entry.location && (
          <div class="fact">
            <dt>場所</dt>
            <dd>{entry.location}</dd>
          </div>
        )
      }
      {
        members.length > 0 && (
          <div class="fact">
            <dt>メンバー</dt>
            <dd>
              <ul class="members">
                {members.map((member) => (
                  <li>
                    {member.name}
                    {member.affiliation && <span class="affiliation">（{member.affiliation}）</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
      {
        entry.audience && (
          <div class="fact">
            <dt>対象</dt>
            <dd>{entry.audience}</dd>
          </div>
        )
      }
      {
        entry.capacity && (
          <div class="fact">
            <dt>定員</dt>
            <dd>{entry.capacity}</dd>
          </div>
        )
      }
      {
        entry.fee && (
          <div class="fact">
            <dt>受講料</dt>
            <dd>{entry.fee}</dd>
          </div>
        )
      }
      {
        application && (
          <div class="fact">
            <dt>募集期間</dt>
            <dd>
              {formatApplicationDate(application.opens)}〜{formatApplicationDate(application.closes)}
            </dd>
          </div>
        )
      }
    </dl>

    {
      entry.notes && entry.notes.length > 0 && (
        <ul class="notes">
          {entry.notes.map((note) => (
            <li>※{note}</li>
          ))}
        </ul>
      )
    }

    {
      /* 3つの状態を全部出力し、hidden で1つだけ見せる。初期状態はビルド時刻で決め、
         閲覧時に下の script で今の時刻に合わせ直す。静的サイトなので、ビルド時刻だけで
         決めると締切後も再デプロイされるまでボタンが残ってしまう（Issue #96） */
      application && applicationTimes && (
        <div
          class="apply"
          data-apply
          data-opens-at={applicationTimes.opensAt}
          data-closes-at={applicationTimes.closesAt}
        >
          <div data-apply-state="open" hidden={applicationStatusAtBuild !== "open"}>
            <Button href={application.url} color="yellow" rotate={-1} target="_blank" rel="noopener noreferrer">
              申し込む →
            </Button>
            <p class="apply-note">
              {formatApplicationDate(application.closes)}まで受付。応募フォーム（外部サイト）が別タブで開きます
            </p>
          </div>
          <p class="apply-closed" data-apply-state="before" hidden={applicationStatusAtBuild !== "before"}>
            {formatApplicationDate(application.opens)}から受付開始
          </p>
          <p class="apply-closed" data-apply-state="closed" hidden={applicationStatusAtBuild !== "closed"}>
            募集は終了しました
          </p>
          {
            application.guideUrl && (
              <p class="apply-guide">
                <a href={application.guideUrl} target="_blank" rel="noopener noreferrer">
                  募集要項・お問い合わせ先（鈴鹿高専HP）
                </a>
              </p>
            )
          }
        </div>
      )
    }

    {
      entry.link && (
        <div class="cta">
          <Button href={entry.link} color="yellow" rotate={-1}>
            やってみる →
          </Button>
        </div>
      )
    }
  </article>
<script>
  import { statusAt } from "../../lib/application";

  /* JSが動かなくても href="/" の普通のリンクとして機能する。
     サイト内から来たときだけ履歴を1つ戻す */
  document.querySelector<HTMLAnchorElement>("a[data-back]")?.addEventListener("click", (event) => {
    const sameOrigin = document.referrer.startsWith(`${location.origin}/`);
    if (!sameOrigin || history.length <= 1) return;

    event.preventDefault();
    history.back();
  });

  /* 申込ボタンの出し分けを閲覧時の時刻で合わせ直す */
  const apply = document.querySelector<HTMLElement>("[data-apply]");
  if (apply) {
    const status = statusAt(Number(apply.dataset.opensAt), Number(apply.dataset.closesAt), Date.now());
    apply.querySelectorAll<HTMLElement>("[data-apply-state]").forEach((el) => {
      el.hidden = el.dataset.applyState !== status;
    });
  }
</script>
</BaseLayout>

<style>
  .entry {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .crumb {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .crumb a {
    text-decoration: underline;
  }

  /* Tape/Chip/Star にpropsで渡したclassは子コンポーネント側のスコープになるため
     :global() が要る（design-system.md §4 参照） */
  .head :global(.cat) {
    font-size: 11px;
    margin-bottom: 12px;
  }

  .name {
    font-size: clamp(22px, 6.5vw, 30px);
    line-height: 1.35;
  }

  .reading {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
    color: #555;
  }

  .group {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin-top: 14px;
  }

  /* 枠は写真の縦横比に合わせる。16:9に固定して切り抜くと、バンドのロゴ画像（正方形）や
     縦長の集合写真で文字やメンバーが切れる */
  .photo {
    position: relative;
    margin-top: 22px;
    background: #f3ebd9;
    border: 2px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    rotate: -0.8deg;
  }
  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .photo :global(.photo-star) {
    position: absolute;
    top: -14px;
    right: -10px;
  }

  .comment {
    position: relative;
    margin-top: 30px;
    padding: 20px 18px 16px;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .comment :global(.comment-label) {
    position: absolute;
    top: -14px;
    left: 12px;
    padding: 4px 14px;
    font-size: 11px;
  }
  .comment blockquote {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.8;
    /* 出演者が入れた改行をそのまま活かす */
    white-space: pre-line;
  }

  .members {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
  }
  .affiliation {
    font-size: 12px;
  }

  .desc {
    margin-top: 26px;
    font-size: 14.5px;
    line-height: 1.9;
    /* データ側の改行をそのまま活かす */
    white-space: pre-line;
  }

  .facts {
    margin-top: 26px;
    border-top: 2px dashed rgba(17, 17, 17, 0.25);
  }

  .fact {
    display: flex;
    gap: 14px;
    padding: 12px 2px;
    border-bottom: 2px dashed rgba(17, 17, 17, 0.25);
    font-size: 14px;
  }

  .fact dt {
    flex: 0 0 4.5em;
    font-weight: 800;
  }

  .fact dd {
    flex: 1;
    min-width: 0;
    line-height: 1.7;
  }

  .days {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .days > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }

  /* 曜日色はポスター準拠の慣例に合わせる（SAT=青 / SUN=赤。design-system.md §1） */
  .day {
    font-size: 17px;
  }

  /* ポスター準拠: SAT=青 / SUN=赤。day1/day2ではなく実際の曜日で決める
     （site.json の日付を変えても色がずれない） */
  .day.sat {
    color: var(--blue);
  }

  .day.sun {
    color: var(--red);
  }

  /* 1日に複数公演ある企画（化学マジック等）は回を横に並べる */
  .times {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .slot-note {
    font-size: 12px;
  }

  .notes {
    list-style: none;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    line-height: 1.7;
    color: #444;
  }

  .cta {
    margin-top: 28px;
  }

  .apply {
    margin-top: 28px;
  }

  /* hidden 属性より display 指定が勝たないよう念のため明示する */
  .apply [hidden] {
    display: none;
  }

  .apply-note {
    margin-top: 14px;
    font-size: 12px;
    line-height: 1.7;
    color: #444;
  }

  .apply-closed {
    display: inline-block;
    padding: 10px 18px;
    border: 2px dashed rgba(17, 17, 17, 0.4);
    font-size: 14px;
    font-weight: 800;
    color: #555;
  }

  .apply-guide {
    margin-top: 14px;
    font-size: 12.5px;
    font-weight: 700;
  }
  .apply-guide a {
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .entry {
      /* --content-narrow はPR #27で追加。未マージのあいだはフォールバックで動く */
      max-width: var(--content-narrow, 700px);
      padding: 40px 24px 96px;
    }
    .desc {
      font-size: 16px;
    }
    .fact {
      font-size: 15px;
    }
  }
</style>
