---
import BaseLayout from "../layouts/BaseLayout.astro";
import CampusMap from "../components/map/CampusMap.astro";
import MapGuide from "../components/map/MapGuide.astro";
import site from "../data/site.json";
---

<BaseLayout title={`MAP | ${site.eventName}`} description="第61回鈴鹿高専祭の会場マップ。ステージ、飲食バザー、展示の場所をご案内します。">
  <section class="map-page" id="map-overview">
    <header><span class="map-eyebrow num" aria-hidden="true">MAP</span><h1>会場マップ</h1></header>
    <CampusMap />
    <MapGuide />
  </section>
</BaseLayout>

<style>
  .map-page { max-width: var(--content-sp); margin: 0 auto; padding: 24px 20px 64px; scroll-margin-top: calc(var(--header-offset-sp) + 16px); }
  .map-eyebrow { color: var(--blue); font-size: 28px; }
  h1 { font-size: 24px; font-weight: 900; margin-top: 4px; }
  @media (min-width: 900px) {
    .map-page { max-width: var(--content-wide); padding: 40px 24px 96px; scroll-margin-top: calc(var(--header-height-pc-shrunk) + 16px); }
    h1 { font-size: 32px; }
  }
</style>
