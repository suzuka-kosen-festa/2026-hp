---
import MapSubpage from "../../components/map/MapSubpage.astro";
import MapEntryList from "../../components/map/MapEntryList.astro";
import { areaByKey, data } from "../../components/map/model";
import IndoorMap from "../../components/map/IndoorMap.astro";
import { indoorBuildings, unplacedIndoor } from "../../components/map/indoor";
const area = areaByKey("exhibition");
const floors = ["1F", "2F", "3F"];
const buildingsOn = (floor: string) => indoorBuildings.filter((building) => building.floor === floor);
---

<MapSubpage compact name={area.name} code={area.code} location={area.location} description="第61回鈴鹿高専祭の展示・レク。校内の棟・階ごとに企画をご案内します。">
  <div class="floor-tabs" role="tablist" aria-label="階の選択" data-floor-tabs hidden>
    {floors.map((floor, index) => <button type="button" role="tab" id={`floor-tab-${floor}`} aria-controls={`floor-${floor}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-floor-tab={floor}>{floor}</button>)}
  </div>
  {floors.map((floor) => <section class="floor-panel" id={`floor-${floor}`} aria-labelledby={`floor-heading-${floor}`} data-floor-panel={floor}>
    <h2 id={`floor-heading-${floor}`}>{floor}</h2>
    <IndoorMap floor={floor} />
    <div class="floor-rooms">
      {/* 棟は上の図で分かるので、一覧は棟の区切りを設けず1つの格子に並べて縦幅を抑える。
          番号札は図の教室コードと同じ表記。棟・階・教室名は各リンクに読み上げ用に持たせ、リンク単体でも場所が分かるようにする */}
      <ul class="room-menu">
        {buildingsOn(floor).flatMap(({ building, rooms }) => rooms.filter((room) => room.entries.length).map((room) => <li id={room.listId} tabindex="-1" data-room-list={room.key} data-building={building} class="room-list">
          <span class="room-badge" aria-hidden="true">{room.short}</span>
          <ul>
            {room.entries.map((venue) => <li><a href={`/entry/${venue.entryId}/`}>
              <strong>{venue.entry.name}</strong>
              <small>{venue.entryId in data.groupOverrides && venue.entry.group}<span class="visually-hidden">{venue.entryId in data.groupOverrides && "／"}{building} {floor}・{room.room}</span></small>
            </a></li>)}
          </ul>
          {room.note && <p class="room-key">{room.note}</p>}
        </li>))}
      </ul>
      {buildingsOn(floor).some(({ rooms }) => rooms.some((room) => room.note && !room.entries.length)) && <dl class="room-uses">
        {buildingsOn(floor).flatMap(({ building, rooms }) => rooms.filter((room) => room.note && !room.entries.length).map((room) => <div>
          <dt><span class="room-badge" aria-hidden="true">{room.short}</span><span class="visually-hidden">{building} {floor}・{room.room}</span></dt>
          <dd>{room.note}</dd>
        </div>))}
      </dl>}
      {unplacedIndoor.some((venue) => venue.floor === floor) && <section data-unplaced-entries>
        <h3>教室の位置を確認中の企画</h3>
        <p>以下は図に配置せず、現在確認できている会場を案内しています。</p>
        {[...new Set(unplacedIndoor.filter((venue) => venue.floor === floor).map((venue) => venue.building))].map((building) => <div data-building={building}>
          <MapEntryList items={unplacedIndoor.filter((venue) => venue.floor === floor && venue.building === building).map((venue) => ({ href: `/entry/${venue.entryId}/`, name: venue.entry.name, sub: `${venue.building} ${venue.floor}${venue.room ? `・${venue.room}` : ""}` }))} />
        </div>)}
      </section>}
    </div>
  </section>)}
</MapSubpage>

<script>
  // 階切替。JSが動くときだけタブにし、動かなければ全階を見出し付きで並べたままにする。
  // 選んだ階はURL（?floor=2F）に残し、企画から戻ったときや共有したときに同じ階を開く。
  const tabList = document.querySelector<HTMLElement>("[data-floor-tabs]");
  if (tabList) {
    const tabs = [...tabList.querySelectorAll<HTMLButtonElement>("[data-floor-tab]")];
    const panels = [...document.querySelectorAll<HTMLElement>("[data-floor-panel]")];
    function selectFloor(floor: string, { focus = false, remember = false } = {}) {
      tabs.forEach((tab) => {
        const active = tab.dataset.floorTab === floor;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.floorPanel !== floor; });
      if (remember) {
        const url = new URL(location.href);
        url.searchParams.set("floor", floor);
        const targetFloor = document.getElementById(url.hash.slice(1))?.closest<HTMLElement>("[data-floor-panel]")?.dataset.floorPanel;
        if (targetFloor && targetFloor !== floor) url.hash = "";
        history.replaceState(history.state, "", url);
      }
    }
    panels.forEach((panel) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `floor-tab-${panel.dataset.floorPanel}`);
      // 図が最初の内容なので、企画リンクの前に配置図を確認できる停止点を設ける。
      panel.tabIndex = 0;
    });
    document.documentElement.classList.add("is-floor-tabbed");
    tabList.hidden = false;
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectFloor(tab.dataset.floorTab!, { remember: true }));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        const edge = { Home: 0, End: tabs.length - 1 }[event.key];
        if (step === undefined && edge === undefined) return;
        event.preventDefault();
        const next = edge ?? (index + step! + tabs.length) % tabs.length;
        selectFloor(tabs[next].dataset.floorTab!, { focus: true, remember: true });
      });
    });
    const requested = new URL(location.href).searchParams.get("floor");
    selectFloor(tabs.some((tab) => tab.dataset.floorTab === requested) ? requested! : tabs[0].dataset.floorTab!);
    function showRoom({ scroll = true } = {}) {
      const id = location.hash.slice(1);
      const target = document.getElementById(id);
      const panel = target?.closest<HTMLElement>("[data-floor-panel]");
      document.querySelectorAll<HTMLElement>("[data-room-target]").forEach((room) => {
        if (room.dataset.roomTarget === id) room.dataset.selectedRoom = "true";
        else delete room.dataset.selectedRoom;
      });
      document.querySelectorAll<HTMLElement>("[data-room-list]").forEach((room) => {
        if (room.id === id) room.dataset.selectedRoom = "true";
        else delete room.dataset.selectedRoom;
      });
      if (!panel || !target) return;
      selectFloor(panel.dataset.floorPanel!, { remember: true });
      requestAnimationFrame(() => target.focus({ preventScroll: !scroll }));
    }
    showRoom();
    // 図の教室を押したときは一覧へスクロールせず、枠で示すだけにする。図と一覧が同じ画面にあり、移動すると図が見えなくなるため。
    document.querySelectorAll<HTMLAnchorElement>("a[data-room-target]").forEach((room) => {
      room.addEventListener("click", (event) => {
        event.preventDefault();
        const oldURL = location.href;
        history.pushState(null, "", `#${room.dataset.roomTarget}`);
        // pushState は hashchange を出さない。MAPに戻るボタンがページ内の移動を知れるよう、ふつうのリンクと同じく知らせる。
        window.dispatchEvent(new HashChangeEvent("hashchange", { oldURL, newURL: location.href }));
        showRoom({ scroll: false });
      });
    });
    // ページ内リンクでも popstate が発火する。hashchange も聞くと focus が二重に走り、Tab で進んだ直後に教室へ引き戻されるため popstate だけで扱う。
    window.addEventListener("popstate", () => {
      const requested = new URL(location.href).searchParams.get("floor");
      selectFloor(tabs.some((tab) => tab.dataset.floorTab === requested) ? requested! : tabs[0].dataset.floorTab!);
      showRoom();
    });
  }
</script>

<style>
  /* 教室リンクは一覧を即座に表示する。JSなしでも移動中のスクロールを待たずに操作できる。 */
  :global(html:has(.floor-panel)) { scroll-behavior: auto; }
  /* 飲食バザーと同じく、スマホ1画面に階のタブ・図・その階の全企画を収める */
  .floor-panel :global(.indoor-map) { margin: 4px 0 2px; }
  .floor-panel :global(.indoor-map figcaption) { margin-top: 4px; font-size: 12px; line-height: 1.6; color: #555; }
  .room-menu { border-top: 2px solid var(--ink); margin-top: 6px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 8px; list-style: none; }
  .room-list { display: grid; grid-template-columns: auto minmax(0, 1fr); align-content: start; gap: 0 6px; padding: 2px 0; border-bottom: 1px dashed #aaa; scroll-margin-top: calc(var(--header-height-pc) + 16px); }
  .room-list:target, .room-list:focus, .room-list[data-selected-room] { outline: 2px solid var(--blue); outline-offset: 2px; }
  .room-list ul { list-style: none; }
  .room-list a { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding: 2px 0; }
  .room-list li + li a { border-top: 1px dotted #ccc; }
  .room-list strong { font-size: 12px; line-height: 1.4; overflow-wrap: anywhere; }
  .room-list small { font-size: 11px; line-height: 1.4; }
  .room-list a:hover strong, .room-list a:active strong { text-decoration: underline; }
  .room-list a:focus-visible { outline: 3px solid var(--blue); outline-offset: -2px; }
  /* 図の黄色い教室と同じ見た目の札。教室コードの長さに合わせて横に伸びる */
  .room-badge { display: inline-grid; place-items: center; min-width: 26px; height: 26px; margin-top: 9px; padding: 0 3px; background: var(--yellow); border: 1.5px solid var(--ink); box-shadow: 1px 1px var(--ink); font-family: var(--font-num), var(--font-body); font-size: 14px; line-height: 1; font-synthesis: none; white-space: nowrap; }
  .room-key { grid-column: 2; font-size: 11px; line-height: 1.4; overflow-wrap: anywhere; }
  .room-uses { display: flex; flex-wrap: wrap; gap: 4px 12px; margin: 6px 0 0; font-size: 12px; line-height: 1.4; }
  .room-uses > div { display: flex; align-items: center; gap: 6px; }
  .room-uses .room-badge { margin: 0; min-width: 22px; height: 22px; font-size: 12px; background: var(--paper); box-shadow: none; }
  .room-uses dd { margin: 0; overflow-wrap: anywhere; }
  /* 他ページのタブ（駐車場・タイムテーブル）と同じく、選択中は赤い下線で示す */
  .floor-tabs:not([hidden]) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; border-bottom: 2px solid var(--ink); }
  .floor-tabs button { min-height: 44px; padding: 4px 16px; font-family: "Bebas Neue", var(--font-body); font-size: 20px; font-synthesis: none; color: var(--ink); background: transparent; border: 0; border-bottom: 3px solid transparent; cursor: pointer; }
  .floor-tabs button[aria-selected="true"] { border-bottom-color: var(--red); color: var(--blue); }
  .floor-tabs button:focus-visible { outline: 3px solid var(--blue); outline-offset: -2px; }
  .floor-panel:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  /* タブ表示中は選択中の階がタブで分かるので、階の見出しは読み上げ用に残して見た目だけ隠す */
  :global(.is-floor-tabbed) .floor-panel > h2 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 900px) {
    .floor-panel:not([hidden]) { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; align-items: start; }
    .floor-panel > h2 { grid-column: 1 / -1; }
  }
</style>
