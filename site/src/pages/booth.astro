---
// ブース一覧ページ
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import Chip from "../components/ui/Chip.astro";
import { entries } from "../lib/loadEntries";
import { getByCategory } from "../lib/entries";
import type { Category } from "../types/content";
import site from "../data/site.json";

const CATEGORIES: Category[] = ["出店", "学科展示", "イベント", "ライブ"];
const sections = CATEGORIES.map((category) => ({
  category,
  items: getByCategory(entries, category),
}));
---

<BaseLayout title={`BOOTH | ${site.eventName}`} description="出店・学科展示・イベント・ライブの一覧">
  <section class="booth">
    <h1 class="page-title">BOOTH</h1>

    {
      sections.map((section) => (
        <div class="tab-section">
          <h2 class="tab-title">{section.category}</h2>
          <ul class="grid">
            {section.items.map((entry, i) => (
              <li>
                <a class="card-link" href={`/entry/${entry.id}/`}>
                  <Card rotate={i % 2 === 0 ? -0.8 : 0.9} attach="none" class="booth-card">
                    <div class="photo">
                      {entry.image ? (
                        <img src={entry.image} alt="" loading="lazy" />
                      ) : (
                        <span class="no-image num">NO IMAGE</span>
                      )}
                    </div>
                    <div class="body">
                      <p class="name">{entry.name}</p>
                      {entry.group && <p class="group">{entry.group}</p>}
                      {entry.summary && <p class="summary">{entry.summary}</p>}
                      {entry.tags.length > 0 && (
                        <ul class="tags">
                          {entry.tags.map((tag, ti) => (
                            <li>
                              <Chip color={ti % 2 === 0 ? "red" : "blue"}>{tag}</Chip>
                            </li>
                          ))}
                        </ul>
                      )}
                      {entry.location && <p class="location">{entry.location}</p>}
                      <span class="more">view more →</span>
                    </div>
                  </Card>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .booth {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .page-title {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 20px;
  }

  .tab-section + .tab-section {
    margin-top: 40px;
  }

  .tab-title {
    font-size: 15px;
    font-weight: 800;
    padding-bottom: 8px;
    margin-bottom: 16px;
    border-bottom: 2px solid var(--ink);
  }

  .grid {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-link {
    display: block;
  }

  .booth :global(.booth-card) {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .photo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: #f3ebd9;
    border-bottom: 2px solid var(--ink);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .no-image {
    font-size: 12px;
    letter-spacing: 0.05em;
    color: #999;
  }

  .body {
    padding: 14px 16px 16px;
  }

  .name {
    font-weight: 800;
    font-size: 15.5px;
  }

  .group {
    font-size: 12.5px;
    color: var(--blue);
    margin-top: 4px;
  }

  .summary {
    font-size: 13px;
    line-height: 1.6;
    margin-top: 8px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin-top: 10px;
  }

  .location {
    font-size: 12px;
    margin-top: 8px;
    color: #555;
  }

  .more {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .booth {
      max-width: var(--content-wide);
      padding: 40px 24px 96px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
</style>
