---
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorsSection from "../components/sections/SponsorsSection.astro";
import Button from "../components/ui/Button.astro";
import site from "../data/site.json";
---

<BaseLayout
  title={`SPONSORS | ${site.eventName}`}
  description="第61回鈴鹿高専祭にご協賛いただいた企業・団体の紹介"
>
  <section class="sponsors-page">
    <SponsorsSection />

    <Button
      href="https://forms.gle/vgvRbGAmfEGoBbxBA"
      target="_blank"
      rel="noopener noreferrer"
      color="yellow"
    >
      個人協賛リンク
    </Button>
  </section>
</BaseLayout>

<style>
  .sponsors-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sponsors-page :global(.button) {
    margin-top: 24px;
  }
</style>