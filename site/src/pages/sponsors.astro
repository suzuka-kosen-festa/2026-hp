---
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorsSection from "../components/sections/SponsorsSection.astro";
import site from "../data/site.json";
---

<BaseLayout
  title={`SPONSORS | ${site.eventName}`}
  description="第61回鈴鹿高専祭にご協賛いただいた企業・団体の紹介"
>
  <section class="sponsors-page">
    {/* 申し込みボタンは個人協賛セクションの中に移した。
        説明を読んだ流れでそのまま押せるようにするため */}
    <SponsorsSection />
  </section>
</BaseLayout>

<style>
  .sponsors-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sponsors-page :global(.button) {
    margin-top: 24px;
  }
</style>