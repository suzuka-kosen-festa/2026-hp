---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tape from "../components/ui/Tape.astro";
import Chip from "../components/ui/Chip.astro";
import site from "../data/site.json";
import { formatNewsDate, getNews, getNewsHref, isNew } from "../lib/news";

const newsItems = getNews();
---

<BaseLayout
  title={`お知らせ | ${site.eventName}`}
  description={`${site.eventName}のお知らせ`}
>
  <section class="news">
    <header class="head">
      <Tape color="blue" rotate={-3} as="p" class="cat">
        NEWS
      </Tape>
    </header>

    <ul class="list">
      {
        newsItems.map((item) => {
          // 遷移先の有無は body から導く（getNewsHref）。href の書き忘れで
          // 「記事はあるのに押せない」状態になるのを防ぐ
          const href = getNewsHref(item);
          const Tag = href ? "a" : "div";

          return (
            <li class="item">
              <Tag class={href ? "link is-link" : "link"} href={href}>
                <div class="meta">
                  <time datetime={formatNewsDate(item.date)} class="date">
                    {item.date}
                  </time>

                  {isNew(item.date) && (
                    <Chip color="red" rotate={-1.5}>
                      NEW
                    </Chip>
                  )}
                </div>

                <h2 class="item-title">{item.title}</h2>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .news {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .head {
    margin-bottom: 12px;
  }

  .head :global(.cat) {
    font-size: 11px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    border-bottom: 2px dashed #bbb;
  }

  .link {
    display: block;
    padding: 18px 4px;
    text-decoration: none;
    color: inherit;
  }

  /* 詳細ページを持つお知らせにだけ「→」を出す。
     ホバーでしか差が出ないと、ホバーの無いスマホでは押せるのかどうかが
     まったく分からない（Issue #63）。矢印は home の「view more →」と同じ語彙 */
  .is-link .item-title::after {
    content: "→";
    margin-left: 8px;
    color: var(--blue);
    font-family: var(--font-num);
    font-weight: 800;
    white-space: nowrap;
  }

  .is-link:hover .item-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .is-link:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .date {
    font-size: 12px;
    font-weight: 800;
    color: var(--blue);
    white-space: nowrap;
  }

  .item-title {
    margin: 7px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }


  @media (min-width: 900px) {
    .news {
      max-width: var(--content-narrow);
      padding: 40px 24px 96px;
    }

    .item-title {
      font-size: 16px;
    }
  }
</style>