---
import BaseLayout from "../layouts/BaseLayout.astro";
import Tape from "../components/ui/Tape.astro";
import Chip from "../components/ui/Chip.astro";
import site from "../data/site.json";
import { getNews }from "../lib/news.ts";
import { isNew } from "../lib/news.ts";


const newsItems = getNews();
---

<BaseLayout title={`お知らせ | ${site.eventName}`} description={`${site.eventName}のお知らせ`}>
  

  <main class="news">

    <p class="crumb"><a href="/">← 戻る</a></p>

    <header class="head">
      <Tape color="blue" rotate={-3} as="p" class="cat">NEWS</Tape>

    </header>
    
    <ul class="list">
      {
        newsItems.map((item) => (
          <li class="item">
            <a href={item.href} class="link">
              <div class="meta">
                <time datetime={item.date} class="date">{item.date.replaceAll("-", ".")}</time>
                {isNew(item.date) && <Chip color="red" rotate={-1.5}>NEW</Chip>}
              </div>

              <h2 class="item-title">{item.title}</h2>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .news {
    max-width: var(--content-sp);
    margin: 0 auto;
    padding: 24px 20px 64px;
  }

  .crumb {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .crumb a {
    text-decoration: underline;
  }

  .head {
    margin-bottom: 12px;
  }

  .title {
    font-size: clamp(26px, 7vw, 34px);
    line-height: 1.35;
  }

  .list {
    list-style: none;

  }

  .item {
    border-bottom: 2px dashed #bbb
  }

  .link {
    display: block;
    padding: 18px 4px;
    text-decoration: none;
  }

  .link:hover .item-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meta time {
    font-weight: 800;
    color: var(--blue);
    white-space: nowrap;
    font-size: 12px;
  }


  .item-title {
    margin-top: 7px;
    font-size: 15px;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .news {
      max-width: var(--content-narrow);
      padding: 40px 24px 96px;
    }

    .item-title {
      font-size: 16px;
    }
  }
</style>