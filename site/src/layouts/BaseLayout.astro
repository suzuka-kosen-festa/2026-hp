---
import SvgDefs from "../components/SvgDefs.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "第61回鈴鹿高専祭「collage」公式サイト", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover: これが無いと env(safe-area-inset-*) が常に0を返す。
      iOS26のSafariはページを画面端まで敷き、ツールバーやステータスバーが
      コンテンツの上に浮くため、安全領域は各自で塞ぐ必要がある（Issue #42） -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- public/ にあるのは .ico と .svg。png を指していて全ページ404していた -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <SvgDefs />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
